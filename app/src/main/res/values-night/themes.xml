<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AirconController" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/classic_accent</item>
        <item name="colorPrimaryVariant">@color/classic_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/classic_accent</item>
        <item name="colorSecondaryVariant">@color/classic_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/classic_bg</item>
        <item name="dkBgBase">@color/classic_bg</item>
        <item name="dkSurface">@color/classic_surface</item>
        <item name="dkSurfaceStroke">@color/classic_stroke</item>
        <item name="dkDividerSoft">@color/classic_divider</item>
        <item name="dkTextPrimary">@color/classic_text</item>
        <item name="dkTextMuted">@color/classic_muted</item>
        <item name="dkAccent">@color/classic_accent</item>
        <item name="dkAccentSoft">@color/classic_accent_soft</item>
        <item name="dkHeading">@color/classic_accent</item>
        <item name="dkTileRadius">20dp</item>
        <item name="dkCardRadius">16dp</item>
        <item name="dkOutlineWidth">1dp</item>
        <!-- Customize your theme here. -->
    </style>
</resources>